# lws-pd-disaggregation guide specification
# Simulated LWS-based PD-disaggregated inference using llm-d-inference-sim. No GPUs required.
# Mirrors wide-ep-lws-nvidia-gpu-vllm-glm-5-2-v2-{prefill,decode-ll} topology.
# See scenarios/lws-pd-disaggregation-sim.yaml for details.

# [REQUIRED]
{% set base_dir = base_dir | default('../') -%}
base_dir: {{ base_dir }}

# [REQUIRED]
values_file:
  path: {{ base_dir }}/benchmark/config/templates/values/defaults.yaml

# [REQUIRED]
template_dir:
  path: {{ base_dir }}/../llm-d-benchmark/config/templates/jinja

# [OPTIONAL]
scenario_file:
  path: {{ base_dir }}/benchmark/config/scenarios/simulator/lws-pd-disaggregation-sim.yaml
